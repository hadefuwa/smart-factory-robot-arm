[Unit]
Description=Vision Service (YOLO detection)
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/sf2/app/backend
ExecStart=/home/pi/sf2/app/backend/venv/bin/python vision_service.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
