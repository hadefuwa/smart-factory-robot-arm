      Online : Bool;
      CPU_Load : Real;
      CPU_Temp : Real;
      Memory_Used_MB : Int;
      Uptime_Minutes : DInt;
      Overloaded : Bool;
      Overtemp : Bool;
   END_STRUCT;

END_TYPE

DATA_BLOCK "EdgeDevice_DB"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
